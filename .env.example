# Copy to .env. Obtain the challenge mock API key through an authorised channel.
VALIO_API_KEY=
# Bind only to this machine; the application otherwise listens on all interfaces.
HOST=127.0.0.1
# Optional: without this key chat uses the built-in keyword fallback.
# VERDA_API_KEY=
# Optional: without approvers the UI is in open demo mode.
# APPROVERS=
# Optional: shared agent token and signing key are generated if unset.
# AGENT_TOKEN=
# SIGNING_KEY=
